#==============================================================================#
# File extensions to be ignored anywhere in the tree.
#==============================================================================#

# Rendered html files.
*.html

# Temporary files created by most text editors.
*~

.vscode/
.idea/

#==============================================================================#
# OS / editor artifacts
#==============================================================================#

.DS_Store
Thumbs.db

#==============================================================================#
# Python
#==============================================================================#

__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Venvs
venv/
env_stim/
.venv/
.venv*/
.venv_*/
.conda

# Pre-trained model weights: distributed via Hugging Face (users) and the
# permanent-draft GitHub release consumed by .github/actions/fetch-models (CI).
# Never commit weights — their license differs from the code license.
/models/

# Outputs & logs
outputs/
logs/
/artifacts/
/run/
/lqcloud_measurements/
/code/ai_model/outputs/**

# Notebooks
*.ipynb_checkpoints

# Precomputed data
/frames_data/
/benchmarks

# Stable public presets, examples, and curated experiment configs are source configs.
/conf/*.yaml
/conf/**/*.yaml
!/conf/config_public.yaml
!/conf/presets/**/*.yaml
!/conf/examples/qadapt/config_qadapt_t0_base.yaml
!/conf/examples/qadapt/config_qadapt_t1_meas_1p5.yaml
!/conf/examples/qadapt/config_qadapt_t2_cnot_1p5.yaml
!/conf/examples/qadapt/config_qadapt_t3_idle_1p5.yaml
!/conf/examples/qadapt/config_qadapt_t4_z_bias_1p5.yaml
!/conf/experiments/
!/conf/experiments/**/*.yaml

# Runtime-generated configs and research documentation/results.
/outputs/generated_configs/
/docs/plans/
/docs/figures/
/docs/*technical_report*
/docs/**/*technical_report*
/docs/**/*.pdf
/docs/**/*.zip
/docs/**/*.csv
/docs/**/*.json

# Tests created during the local research campaigns are intentionally local.
/code/tests/experiments/
/code/tests/providers/
/code/tests/test_lqcloud_*.py

# paper
/paper
/patent

# Local dev artifacts
/EXECUTIVE_SUMMARY.md
/LATEST_COMMIT_EXPLANATION.md
/MR_COMMENT_DRAFT.md
/MR_REVIEW_SUMMARY.md
/dev_history/

# SLURM job logs
predecoder_train_*.out
predecoder_train_*.err
sbatch_logs/

# agents.md
AGENTS.md
